# Backyard Monsters Refitted - Web Launcher Configuration

# Port where the web launcher will be served
PORT=8080

# Default Server URL to connect to:
# - Official Server: https://server.bymrefitted.com/
# - Local Server:    http://localhost:3001/
DEFAULT_SERVER_URL=https://server.bymrefitted.com/

# Default CDN URL for game assets (images, sounds, language packs):
# - Official CDN:    https://cdn.bymrefitted.com/
# - Local CDN:       http://localhost:3001/
DEFAULT_CDN_URL=https://cdn.bymrefitted.com/

# Cloudflare Access Service Token (Optional)
# If your backend is protected behind Cloudflare Access / Zero Trust application gate:
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Cloudflare Tunnel Token (Optional, for running cloudflared alongside the container)
# Obtain from https://one.dash.cloudflare.com/ -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
